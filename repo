:- dynamic area_legal/1.
:- dynamic caso_previo/1.
:- dynamic situacion_actual/1.
:- dynamic feedback/1.

% =========================
% BASE DE CONOCIMIENTO LEGAL
% =========================

% Áreas legales
area(1, derecho_penal).
area(2, derecho_civil).
area(3, derecho_laboral).
area(4, derecho_familiar).

% Situaciones legales
situacion(1, despido_injustificado).
situacion(2, incumplimiento_contrato).
situacion(3, violencia_familiar).
situacion(4, robo).

% Casos previos
caso(1, ninguno).
caso(2, incumplimiento_contrato).

% =========================
% LEYES (Base legal real)
% =========================

ley(derecho_penal, codigo_penal).
ley(derecho_civil, codigo_civil).
ley(derecho_laboral, ley_trabajo).
ley(derecho_familiar, ley_familia).

% =========================
% JURISPRUDENCIA
% =========================

jurisprudencia(despido_injustificado, caso_001).
jurisprudencia(incumplimiento_contrato, caso_002).
jurisprudencia(violencia_familiar, caso_003).
jurisprudencia(robo, caso_004).

% =========================
% REGLAS CON PUNTAJE
% =========================

puntaje(consultar_abogado_penal, 5) :- area_legal(derecho_penal).
puntaje(consultar_abogado_civil, 5) :- area_legal(derecho_civil).
puntaje(consultar_abogado_laboral, 5) :- area_legal(derecho_laboral).
puntaje(consultar_abogado_familiar, 5) :- area_legal(derecho_familiar).

puntaje(demandar_empresa, 8) :- situacion_actual(despido_injustificado).
puntaje(revisar_contrato, 7) :- situacion_actual(incumplimiento_contrato).
puntaje(denunciar, 10) :- situacion_actual(violencia_familiar).
puntaje(reportar_delito, 9) :- situacion_actual(robo).

puntaje(asesoria_integral, 6) :- caso_previo(incumplimiento_contrato).

% =========================
% EXPLICACIONES
% =========================

explicacion(consultar_abogado_penal, 'Caso del area penal').
explicacion(consultar_abogado_civil, 'Conflicto civil detectado').
explicacion(consultar_abogado_laboral, 'Problema laboral').
explicacion(consultar_abogado_familiar, 'Conflicto familiar').
explicacion(demandar_empresa, 'Despido injustificado').
explicacion(revisar_contrato, 'Incumplimiento de contrato').
explicacion(denunciar, 'Violencia familiar detectada').
explicacion(reportar_delito, 'Delito detectado').
explicacion(asesoria_integral, 'Tiene antecedentes similares').

% =========================
% INICIO
% =========================

inicio :-
    limpiar,
    write('===== SISTEMA EXPERTO LEGAL ====='), nl,
    preguntar_area,
    preguntar_situacion,
    preguntar_caso,
    mejor_recomendacion,
    guardar_feedback.

% =========================
% VALIDACION GENERICA
% =========================

leer_opcion_valida(Predicado, Valor) :-
    read(Opcion),
    (call(Predicado, Opcion, Valor) ->
        true
    ;
        write('❌ Opcion invalida, intente de nuevo'), nl,
        leer_opcion_valida(Predicado, Valor)
    ).

% =========================
% PREGUNTAS CON VALIDACION
% =========================

preguntar_area :-
    write('Seleccione area legal:'), nl,
    mostrar_areas,
    leer_opcion_valida(area, A),
    assert(area_legal(A)).

mostrar_areas :-
    area(N, A),
    write(N), write('. '), write(A), nl,
    fail.
mostrar_areas.

preguntar_situacion :-
    write('Seleccione situacion:'), nl,
    mostrar_situaciones,
    leer_opcion_valida(situacion, S),
    assert(situacion_actual(S)).

mostrar_situaciones :-
    situacion(N, S),
    write(N), write('. '), write(S), nl,
    fail.
mostrar_situaciones.

preguntar_caso :-
    write('¿Tiene casos previos?'), nl,
    mostrar_casos,
    leer_opcion_valida(caso, C),
    (C \= ninguno -> assert(caso_previo(C)) ; true).

mostrar_casos :-
    caso(N, C),
    write(N), write('. '), write(C), nl,
    fail.
mostrar_casos.

% =========================
% MOTOR DE DECISION
% =========================

mejor_recomendacion :-
    findall(P-R, puntaje(R, P), Lista),
    sort(Lista, Ordenada),
    reverse(Ordenada, [MejorPuntaje-Mejor|_]),
    nl,
    write('>>> MEJOR RECOMENDACION <<<'), nl,
    write(Mejor), nl,
    explicacion(Mejor, Exp),
    write('Motivo: '), write(Exp), nl,
    write('Puntaje: '), write(MejorPuntaje), nl.

% =========================
% FEEDBACK
% =========================

guardar_feedback :-
    write('¿La recomendacion fue util? (1=si, 2=no): '),
    read(R),
    (R = 1 -> assert(feedback(positivo))
    ; R = 2 -> assert(feedback(negativo))
    ; write('❌ Opcion invalida'), nl, guardar_feedback).

% =========================
% LIMPIAR
% =========================

limpiar :-
    retractall(area_legal(_)),
    retractall(situacion_actual(_)),
    retractall(caso_previo(_)).
